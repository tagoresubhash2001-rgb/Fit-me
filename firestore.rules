rules_version = '2';

// FIT ME AI Firestore Security Rules (PRD section 13).
// - Users read and write only their own data under users/{uid}.
// - entitlements, foods, exercises, appConfig and other global data are server-write only
//   (Cloud Functions use the Admin SDK, which bypasses these rules).
// - Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields a client may never set on its own profile.
    function noServerFields() {
      return !request.resource.data.keys().hasAny(['role', 'roles', 'plan', 'entitlement', 'isAdmin', 'deletedAt']);
    }

    // Every health record carries id, uid, timestamps, local date, timezone, source and status.
    function validRecord(uid, docId) {
      let d = request.resource.data;
      return d.uid == uid
        && d.id == docId
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.tz is string && d.tz.size() > 0 && d.tz.size() < 64
        && d.source in ['manual', 'ai', 'device', 'import']
        && d.status in ['active', 'deleted', 'planned', 'completed', 'skipped']
        && noServerFields();
    }

    // createdAt and uid cannot change after creation.
    function immutableOnUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid && noServerFields();
      allow update: if isOwner(uid) && request.resource.data.uid == uid && noServerFields();

      // Health and activity logs, plans, schedule, habits, reports.
      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods'];
        allow create: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods']
          && validRecord(uid, docId);
        allow update: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods']
          && validRecord(uid, docId)
          && immutableOnUpdate();
      }

      // Settings documents (consents, notification preferences, device connections).
      match /settings/{docId} {
        allow read, write: if isOwner(uid) && docId in ['consents', 'notifications', 'devices'];
      }

      // AI chat threads: the user reads and can delete; messages are written only by the server
      // so the stored conversation always matches what the orchestrator saw.
      match /aiThreads/{threadId} {
        allow read, delete: if isOwner(uid);
        match /messages/{messageId} {
          allow read, delete: if isOwner(uid);
        }
      }
    }

    // Plan entitlements: written only by Cloud Functions (RevenueCat / Cashfree webhooks).
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Global reference data: readable by signed-in users, writable only by the server.
    match /foods/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /appConfig/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Store "Notify me" waitlist: one document per user, create/read/delete own only.
    match /storeWaitlist/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'country', 'language'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is timestamp;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
