# Copy to .env.development (fitmeai-dev), .env.staging (fitmeai-staging) or .env.production (fitmeai-prod).
# Firebase web config values are public identifiers, not secrets. Real secrets (Gemini, RevenueCat,
# Cashfree, AdMob) live only in Secret Manager for Cloud Functions, never here.
VITE_ENV=dev
VITE_USE_EMULATORS=false
VITE_FUNCTIONS_REGION=asia-south1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fitmeai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fitmeai-dev
VITE_FIREBASE_STORAGE_BUCKET=fitmeai-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# App Check: reCAPTCHA Enterprise site key for the web app (staging/prod), debug token for dev only.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
VITE_DISTRIBUTION=   # web | direct | play | appstore (default: web in browser, direct on Android, appstore on iOS)
