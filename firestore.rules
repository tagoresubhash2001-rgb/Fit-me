rules_version = '2';

// FitMe Firestore Security Rules (PRD section 13).
// - Users read and write only their own data under users/{uid}.
// - entitlements, foods, exercises, appConfig and other global data are server-write only
//   (Cloud Functions use the Admin SDK, which bypasses these rules).
// - Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Active paid plan, read from the server-written entitlement (PRD section 3).
    function hasSubscription(plans) {
      let path = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return exists(path)
        && get(path).data.plan in plans
        && get(path).data.get('status', 'active') != 'expired'
        && (!('expiresAt' in get(path).data) || get(path).data.expiresAt == null || get(path).data.expiresAt > request.time);
    }

    // Free stages (7-day Welcome Unlock, then the 30-day Free Trial), from the server-written access record.
    function hasStage(plans) {
      let path = /databases/$(database)/documents/access/$(request.auth.uid);
      return exists(path) && get(path).data.eligible == true
        && ((request.time < get(path).data.welcomeEndsAt && get(path).data.welcomePlan in plans)
          || (request.time < get(path).data.trialEndsAt && get(path).data.trialPlan in plans));
    }

    function hasPlan(plans) {
      return signedIn() && (hasSubscription(plans) || hasStage(plans));
    }

    // A profile photo can only point at the user's own file in Storage (users/{uid}/profile/avatar-<time>.jpg).
    function validPhoto(uid) {
      let d = request.resource.data;
      return (!('photoPath' in d) || d.photoPath == null || (d.photoPath is string && d.photoPath.matches('users/' + uid + '/profile/avatar-[0-9]{10,16}[.]jpg')))
        && (!('photoURL' in d) || d.photoURL == null
          || (d.photoURL is string && d.photoURL.size() < 600
            && (d.photoURL.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/users%2F' + uid + '%2Fprofile%2F.*')
              || d.photoURL.matches('http://(127[.]0[.]0[.]1|localhost):9199/v0/b/[^/]+/o/users%2F' + uid + '%2Fprofile%2F.*'))));
    }

    // Staff role from the Auth custom claim (set only by Cloud Functions).
    function staffRole() {
      return signedIn() && request.auth.token.get('role', null) in ['superAdmin', 'admin', 'finance', 'content', 'support', 'moderator'];
    }
    // Same matrix as src/domain/adminRoles.ts for the collections staff read directly.
    function roleIn(roles) {
      return signedIn() && request.auth.token.get('role', null) in roles;
    }

    // Fields a client may never set on its own profile.
    function noServerFields() {
      return !request.resource.data.keys().hasAny(['role', 'roles', 'plan', 'entitlement', 'isAdmin', 'deletedAt']);
    }

    // Every health record carries id, uid, timestamps, local date, timezone, source and status.
    function validRecord(uid, docId) {
      let d = request.resource.data;
      return d.uid == uid
        && d.id == docId
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.tz is string && d.tz.size() > 0 && d.tz.size() < 64
        && d.source in ['manual', 'ai', 'device', 'import']
        && d.status in ['active', 'deleted', 'planned', 'completed', 'skipped']
        && noServerFields();
    }

    // createdAt and uid cannot change after creation.
    function immutableOnUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid && noServerFields() && validPhoto(uid);
      allow update: if isOwner(uid) && request.resource.data.uid == uid && noServerFields() && validPhoto(uid);

      // Health and activity logs, plans, schedule, habits, reports.
      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods', 'healthDaily'];
        allow create: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods', 'healthDaily']
          && validRecord(uid, docId);
        allow update: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods', 'healthDaily']
          && validRecord(uid, docId)
          && immutableOnUpdate();
      }

      // Settings documents (consents, notification preferences, device connections).
      match /settings/{docId} {
        allow read, write: if isOwner(uid) && docId in ['consents', 'notifications', 'devices'];
      }

      // AI chat threads: the user reads and can delete; messages are written only by the server
      // so the stored conversation always matches what the orchestrator saw.
      // Inbox (admin messages, support replies, reminders): written by Functions; the owner reads it, marks it
      // read (readAt only) or deletes it.
      match /inbox/{id} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt is timestamp;
      }

      match /aiThreads/{threadId} {
        allow read, delete: if isOwner(uid);
        match /messages/{messageId} {
          allow read, delete: if isOwner(uid);
        }
      }
    }

    // Free-stage record (dates from the Auth creation time): written only by Cloud Functions.
    match /access/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Plan entitlements: written only by Cloud Functions (RevenueCat / Cashfree webhooks).
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Global reference data: readable by signed-in users, writable only by the server.
    match /foods/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Micronutrients per food: Premium and Pro only (enforced here, not just hidden in the UI).
    match /foodMicros/{id} {
      allow read: if hasPlan(['premium', 'pro']);
      allow write: if false;
    }
    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Public config (texts, features, maintenance, prices) is readable before sign-in; the rest needs an account.
    match /appConfig/{id} {
      allow read: if signedIn() || id in ['app', 'content', 'strings', 'features', 'pricing', 'plans', 'policy'];
      allow write: if false;
    }
    // Published pages (FAQ, help, legal, tips) for everyone; drafts only through the admin function.
    match /pages/{slug} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    // In-app announcements: signed-in members read; the app shows only the live ones for their country / plan.
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Admin grant of free access (read by the owner to show their plan; written only by the admin function).
    match /grants/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Store "Notify me" waitlist: one document per user, create/read/delete own only.
    match /storeWaitlist/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'country', 'language'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is timestamp;
    }

    // Plan purchase interest while payments are not launched yet (owner correction 6).
    match /planInterest/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'plan', 'period', 'currency', 'country', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.plan in ['premium', 'pro']
        && request.resource.data.get('period', 'monthly') in ['monthly', 'quarterly', 'yearly']
        && request.resource.data.currency is string && request.resource.data.currency.size() == 3
        && request.resource.data.country is string && request.resource.data.country.size() == 2
        && request.resource.data.updatedAt is timestamp;
    }

    // ---- Testimonials ----
    // Private submissions: the author and staff only. All writes go through Cloud Functions, which validate,
    // keep the status workflow and are the only way to publish.
    match /testimonials/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || roleIn(['superAdmin', 'admin', 'content', 'support', 'moderator']);
      allow write: if false;
    }
    // Published copies of approved testimonials only: anyone may read, nobody may write from a client.
    match /publicTestimonials/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Admin (read for staff; every change goes through a logged Cloud Function) ----
    match /adminLogs/{id} {
      allow read: if roleIn(['superAdmin', 'admin', 'finance']);
      allow write: if false; // immutable: no client can create, change or delete entries
    }
    match /staff/{uid} {
      allow read: if staffRole();
      allow write: if false;
    }
    match /appConfigVersions/{id} {
      allow read: if staffRole();
      allow write: if false;
    }
    match /foodSuggestions/{id} {
      allow read: if roleIn(['superAdmin', 'admin', 'content', 'support', 'moderator']);
      allow write: if false;
    }
    match /userStatus/{uid} {
      allow read: if isOwner(uid) || staffRole();
      allow write: if false;
    }

    // ---------------------------------------------------------------- Public website collections
    // Release info for the download page and the in-app updater (app_config/android, app_config/ios):
    // anyone may read; only a super admin or admin may change it (Admin -> Releases).
    match /app_config/{docId} {
      allow read: if docId in ['android', 'ios'];
      allow write: if roleIn(['superAdmin', 'admin']) && docId in ['android', 'ios'];
    }

    function emailOk(e) {
      return e is string && e.size() > 5 && e.size() < 254 && e.matches('[^@\\s]+@[^@\\s]+[.][^@\\s]+');
    }
    function textOk(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // iOS waitlist (older download page): public create only, with a fixed shape; staff read and export.
    match /ios_waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source', 'device'])
        && emailOk(request.resource.data.email)
        && request.resource.data.createdAt == request.time
        && (!('source' in request.resource.data) || textOk(request.resource.data.source, 1, 40))
        && (!('device' in request.resource.data) || textOk(request.resource.data.device, 0, 400));
      allow read, delete: if staffRole();
      allow update: if false;
    }

    // Website contact form: public create only, fixed shape and sizes; support staff read and update the status.
    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'status', 'source', 'locale'])
        && textOk(request.resource.data.name, 1, 120)
        && emailOk(request.resource.data.email)
        && textOk(request.resource.data.subject, 0, 160)
        && textOk(request.resource.data.message, 10, 5000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'website'
        && textOk(request.resource.data.locale, 2, 12);
      allow read: if roleIn(['superAdmin', 'admin', 'support', 'moderator']);
      allow update: if roleIn(['superAdmin', 'admin', 'support', 'moderator'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledAt']);
      allow delete: if roleIn(['superAdmin', 'admin']);
    }

    // Account deletion requests from the public /delete-account page (Google Play requirement).
    match /deletion_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'reason', 'requestedAt', 'status'])
        && emailOk(request.resource.data.email)
        && textOk(request.resource.data.reason, 0, 1000)
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == 'pending';
      allow read, update: if roleIn(['superAdmin', 'admin', 'support', 'moderator']);
      allow delete: if false;
    }

    // Download counts are written by the server only.
    match /app_downloads/{id} {
      allow read: if staffRole();
      allow write: if false;
    }

    // Everything else is denied (trialRegistry, billing, usage, payments, aiUsage ...).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
