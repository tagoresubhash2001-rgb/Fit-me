{
  "name": "fit-me-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "screenshots": "node e2e/screenshots.cjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-fitmeai 'vitest run --config vitest.rules.config.ts'",
    "test:integration": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions,storage --project demo-fitmeai 'vitest run --config vitest.integration.config.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:emulators": "vite --mode emulators",
    "preview": "vite preview",
    "e2e": "node e2e/flow.cjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor-firebase/app-check": "^8.6.0",
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor-firebase/messaging": "8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capgo/capacitor-health": "^8.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.19.0",
    "flag-icons": "^7.6.0",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.3.1",
    "vite": "^6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "1.9.20",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.2",
    "country-region-data": "^4.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.7",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
