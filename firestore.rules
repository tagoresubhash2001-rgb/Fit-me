rules_version = '2';

// FIT ME AI Firestore Security Rules (PRD section 13).
// - Users read and write only their own data under users/{uid}.
// - entitlements, foods, exercises, appConfig and other global data are server-write only
//   (Cloud Functions use the Admin SDK, which bypasses these rules).
// - Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Active paid plan, read from the server-written entitlement (PRD section 3).
    function hasSubscription(plans) {
      let path = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return exists(path)
        && get(path).data.plan in plans
        && get(path).data.get('status', 'active') != 'expired'
        && (!('expiresAt' in get(path).data) || get(path).data.expiresAt == null || get(path).data.expiresAt > request.time);
    }

    // Free stages (7-day Welcome Unlock, then the 30-day Free Trial), from the server-written access record.
    function hasStage(plans) {
      let path = /databases/$(database)/documents/access/$(request.auth.uid);
      return exists(path) && get(path).data.eligible == true
        && ((request.time < get(path).data.welcomeEndsAt && get(path).data.welcomePlan in plans)
          || (request.time < get(path).data.trialEndsAt && get(path).data.trialPlan in plans));
    }

    function hasPlan(plans) {
      return signedIn() && (hasSubscription(plans) || hasStage(plans));
    }

    // Fields a client may never set on its own profile.
    function noServerFields() {
      return !request.resource.data.keys().hasAny(['role', 'roles', 'plan', 'entitlement', 'isAdmin', 'deletedAt']);
    }

    // Every health record carries id, uid, timestamps, local date, timezone, source and status.
    function validRecord(uid, docId) {
      let d = request.resource.data;
      return d.uid == uid
        && d.id == docId
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.tz is string && d.tz.size() > 0 && d.tz.size() < 64
        && d.source in ['manual', 'ai', 'device', 'import']
        && d.status in ['active', 'deleted', 'planned', 'completed', 'skipped']
        && noServerFields();
    }

    // createdAt and uid cannot change after creation.
    function immutableOnUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid && noServerFields();
      allow update: if isOwner(uid) && request.resource.data.uid == uid && noServerFields();

      // Health and activity logs, plans, schedule, habits, reports.
      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods', 'healthDaily'];
        allow create: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods', 'healthDaily']
          && validRecord(uid, docId);
        allow update: if isOwner(uid)
          && collection in ['foodLogs', 'waterLogs', 'workoutLogs', 'weightLogs', 'sleepLogs', 'stepLogs',
                            'plans', 'schedule', 'habits', 'reports', 'savedMeals', 'recipes', 'customFoods', 'healthDaily']
          && validRecord(uid, docId)
          && immutableOnUpdate();
      }

      // Settings documents (consents, notification preferences, device connections).
      match /settings/{docId} {
        allow read, write: if isOwner(uid) && docId in ['consents', 'notifications', 'devices'];
      }

      // AI chat threads: the user reads and can delete; messages are written only by the server
      // so the stored conversation always matches what the orchestrator saw.
      match /aiThreads/{threadId} {
        allow read, delete: if isOwner(uid);
        match /messages/{messageId} {
          allow read, delete: if isOwner(uid);
        }
      }
    }

    // Free-stage record (dates from the Auth creation time): written only by Cloud Functions.
    match /access/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Plan entitlements: written only by Cloud Functions (RevenueCat / Cashfree webhooks).
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Global reference data: readable by signed-in users, writable only by the server.
    match /foods/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Micronutrients per food: Premium and Pro only (enforced here, not just hidden in the UI).
    match /foodMicros/{id} {
      allow read: if hasPlan(['premium', 'pro']);
      allow write: if false;
    }
    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /appConfig/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Store "Notify me" waitlist: one document per user, create/read/delete own only.
    match /storeWaitlist/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'country', 'language'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is timestamp;
    }

    // Plan purchase interest while payments are not launched yet (owner correction 6).
    match /planInterest/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'plan', 'period', 'currency', 'country', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.plan in ['premium', 'pro']
        && request.resource.data.get('period', 'monthly') in ['monthly', 'quarterly', 'yearly']
        && request.resource.data.currency is string && request.resource.data.currency.size() == 3
        && request.resource.data.country is string && request.resource.data.country.size() == 2
        && request.resource.data.updatedAt is timestamp;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
